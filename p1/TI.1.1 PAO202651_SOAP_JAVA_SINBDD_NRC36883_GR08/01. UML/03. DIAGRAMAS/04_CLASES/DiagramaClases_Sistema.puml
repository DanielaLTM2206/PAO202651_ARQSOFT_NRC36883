@startuml
title Diagrama de Clases - Sistema de Conversion SOAP Multi-Canal (PAO 202651 - GR08)
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "ec.edu.monster.service (Capa de Exposicion SOAP JAX-WS)" {
    class WSConversorUnidades <<@WebService>> {
        - servicioSeguridad: ServicioSeguridad
        - catalogoUnidades: CatalogoUnidades
        - motorConversion: MotorConversion
        + autenticar(usuario: String, clave: String): RespuestaAutenticacion
        + consultarCatalogo(token: String): RespuestaCatalogo
        + consultarUnidadesPorCategoria(categoria: String, token: String): RespuestaCatalogo
        + convertir(valor: double, unidadOrigen: String, unidadDestino: String, token: String): RespuestaConversion
        + convertirLongitud(valor: double, origen: String, destino: String, token: String): RespuestaConversion
        + convertirMasa(valor: double, origen: String, destino: String, token: String): RespuestaConversion
        + convertirTemperatura(valor: double, origen: String, destino: String, token: String): RespuestaConversion
        + consultarHistorial(token: String): RespuestaHistorial
        + limpiarHistorial(token: String): RespuestaConversion
    }
}

package "ec.edu.monster.security (Capa de Seguridad en Memoria)" {
    class ServicioSeguridad {
        - {static} USUARIO_VALIDO: String = "monster"
        - {static} CLAVE_VALIDA: String = "monster9"
        - {static} TOKEN_TTL: Duration = 30 min
        - {static} sesionesActivas: Map<String, SesionInfo>
        + autenticar(usuario: String, clave: String): RespuestaAutenticacion
        + validarToken(token: String): ResultadoValidacionToken
        + cerrarSesion(token: String): boolean
    }

    class ResultadoValidacionToken {
        - valido: boolean
        - codigo: String
        - mensaje: String
        + isValido(): boolean
        + getCodigo(): String
        + getMensaje(): String
        + {static} exitoso(): ResultadoValidacionToken
        + {static} invalido(msg: String): ResultadoValidacionToken
        + {static} expirado(msg: String): ResultadoValidacionToken
    }
}

package "ec.edu.monster.conversion (Capa de Logica Matematica)" {
    class MotorConversion {
        - servicioSeguridad: ServicioSeguridad
        - catalogoUnidades: CatalogoUnidades
        - conversorLongitud: ConversorLongitud
        - conversorMasa: ConversorMasa
        - conversorTemperatura: ConversorTemperatura
        + procesarConversion(valor: Double, origen: String, destino: String, token: String): RespuestaConversion
    }

    class ConversorLongitud {
        - {static} FACTOR_CENTIMETROS: double = 0.01
        - {static} FACTOR_METROS: double = 1.0
        - {static} FACTOR_PIES: double = 0.3048
        - {static} FACTOR_YARDAS: double = 0.9144
        - {static} FACTOR_MILLAS: double = 1609.34
        + convertir(valor: double, origen: String, destino: String): double
        - obtenerFactor(unidad: String): double
    }

    class ConversorMasa {
        - {static} FACTOR_GRAMOS: double = 0.001
        - {static} FACTOR_KILOGRAMOS: double = 1.0
        - {static} FACTOR_ONZAS: double = 0.0283495
        - {static} FACTOR_LIBRAS: double = 0.453592
        - {static} FACTOR_QUINTALES: double = 45.3592
        + convertir(valor: double, origen: String, destino: String): double
        - obtenerFactor(unidad: String): double
    }

    class ConversorTemperatura {
        + convertir(valor: double, origen: String, destino: String): double
    }
}

package "ec.edu.monster.catalog (Catalogo de Unidades)" {
    class CatalogoUnidades {
        + {static} CAT_LONGITUD: String = "Longitud"
        + {static} CAT_MASA: String = "Masa"
        + {static} CAT_TEMPERATURA: String = "Temperatura"
        + obtenerCatalogoCompleto(): List<CategoriaDTO>
        + obtenerPorCategoria(categoria: String): CategoriaDTO
        + esUnidadSoportada(unidad: String): boolean
        + obtenerCategoriaDeUnidad(unidad: String): String
        + {static} normalizar(unidad: String): String
    }
}

package "ec.edu.monster.history (Historial Compartido en Memoria)" {
    class GestorHistorial {
        - {static} instancia: GestorHistorial
        - historial: List<RegistroHistorialDTO>
        + {static} getInstance(): GestorHistorial
        + registrar(cat: String, val: double, orig: String, res: double, dest: String): void
        + obtenerHistorial(): List<RegistroHistorialDTO>
        + limpiarHistorial(): void
    }
}

package "ec.edu.monster.model (Modelos DTO y Respuestas Estructuradas)" {
    class RespuestaAutenticacion {
        - estado: String
        - codigo: String
        - mensaje: String
        - token: String
        + getEstado(): String
        + getToken(): String
    }

    class RespuestaConversion {
        - estado: String
        - codigo: String
        - mensaje: String
        - resultado: Double
        - categoria: String
        - unidadOrigen: String
        - unidadDestino: String
        - valorOriginal: Double
    }

    class RespuestaCatalogo {
        - estado: String
        - codigo: String
        - mensaje: String
        - categoria: List<CategoriaDTO>
    }

    class RespuestaHistorial {
        - estado: String
        - codigo: String
        - mensaje: String
        - item: List<RegistroHistorialDTO>
    }

    class CategoriaDTO {
        - nombre: String
        - unidadBase: String
        - unidad: List<String>
    }

    class RegistroHistorialDTO {
        - id: long
        - fechaHora: String
        - categoria: String
        - valorOrigen: double
        - unidadOrigen: String
        - valorDestino: double
        - unidadDestino: String
    }
}

package "Consumidores Multi-Canal (Clientes SOAP)" {
    class ClienteConsola {
        - controlador: ControladorConversiones
        - vista: InterfazConsola
    }

    class ClienteEscritorio {
        - controlador: ControladorConversiones
        - loginFrame: LoginFrame
        - interfaz: InterfazConversiones
    }

    class ClienteWeb {
        - loginServlet: LoginServlet
        - conversorServlet: ConversorServlet
        - jsp: index.jsp / conversor.jsp
    }

    class ClienteMovil {
        - loginActivity: LoginActivity
        - conversionActivity: ConversionActivity
        - loginController: LoginController
        - conversionController: ConversionController
        - soapClient: SoapClient
    }
}

WSConversorUnidades --> ServicioSeguridad : valida token y credenciales
WSConversorUnidades --> CatalogoUnidades : consulta categorias
WSConversorUnidades --> MotorConversion : procesa conversiones
WSConversorUnidades --> GestorHistorial : gestiona registros
MotorConversion --> ConversorLongitud : calcula
MotorConversion --> ConversorMasa : calcula
MotorConversion --> ConversorTemperatura : calcula
MotorConversion --> CatalogoUnidades : valida unidades
MotorConversion --> ServicioSeguridad : valida token
MotorConversion --> GestorHistorial : registra exito

WSConversorUnidades ..> RespuestaAutenticacion : retorna
WSConversorUnidades ..> RespuestaConversion : retorna
WSConversorUnidades ..> RespuestaCatalogo : retorna
WSConversorUnidades ..> RespuestaHistorial : retorna

ClienteConsola ..> WSConversorUnidades : consume SOAP (HTTP POST / WSDL)
ClienteEscritorio ..> WSConversorUnidades : consume SOAP (HTTP POST / WSDL)
ClienteWeb ..> WSConversorUnidades : consume SOAP (HTTP POST / WSDL)
ClienteMovil ..> WSConversorUnidades : consume SOAP (HTTP POST / WSDL)

@enduml
