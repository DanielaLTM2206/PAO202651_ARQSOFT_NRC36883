<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas unitarias del cliente móvil. Una app de Android no puede ejecutar xUnit directamente,
    así que este proyecto compila el mismo código de la app (Cliente, Modelo, Controlador y Util, más el
    proxy SOAP generado) y lo prueba en la PC. Las pantallas (Vista) dependen de MAUI y no se incluyen,
    igual que ConfiguracionServidor, que usa las preferencias del teléfono.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ec.edu.monster.Pruebas</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Enlaces a los mismos archivos de la app (no son copias): se ven en la carpeta Codigo -->
  <ItemGroup>
    <Compile Include="..\Cliente\**\*.cs" Link="Codigo\Cliente\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Connected Services\ReferenciaServicio\Reference.cs" Link="Codigo\ReferenciaServicio\Reference.cs" />
    <Compile Include="..\Modelo\**\*.cs" Link="Codigo\Modelo\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Controlador\**\*.cs" Link="Codigo\Controlador\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Util\**\*.cs" Exclude="..\Util\ConfiguracionServidor.cs"
             Link="Codigo\Util\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Http" Version="10.0.652802" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="10.0.652802" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
