@* Cuadro de confirmación propio del sitio (reemplaza al confirm() del navegador, que muestra "localhost dice").
   Lo abren los formularios con data-confirmar; ver site.js. *@
<div class="modal fade" id="dialogoConfirmacion" tabindex="-1" aria-labelledby="dialogoTitulo"
     aria-describedby="dialogoMensaje" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dialogo">
            <div class="dialogo-icono" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="30" height="30">
                    <path fill="currentColor" d="M12 2 1 21h22L12 2Zm0 4.2L19.5 19h-15L12 6.2ZM11 10v5h2v-5h-2Zm0 6v2h2v-2h-2Z" />
                </svg>
            </div>
            <h2 class="dialogo-titulo" id="dialogoTitulo">¿Está seguro?</h2>
            <p class="dialogo-mensaje" id="dialogoMensaje"></p>
            <div class="dialogo-botones">
                <button type="button" class="boton boton-secundario" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="boton boton-peligro" id="dialogoAceptar">Aceptar</button>
            </div>
        </div>
    </div>
</div>
