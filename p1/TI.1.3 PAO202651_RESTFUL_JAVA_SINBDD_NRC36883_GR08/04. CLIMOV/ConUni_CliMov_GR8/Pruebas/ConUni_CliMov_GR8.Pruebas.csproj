<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas unitarias del cliente móvil. Una app de Android no puede ejecutar xUnit directamente,
    así que este proyecto compila el mismo código de la app (Cliente, Modelo, Controlador y Util)
    y lo prueba en la PC. Las pantallas (Vista) dependen de MAUI y no se incluyen.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ec.edu.monster.Pruebas</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Cliente\**\*.cs" Link="Codigo\Cliente\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Modelo\**\*.cs" Link="Codigo\Modelo\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Controlador\**\*.cs" Link="Codigo\Controlador\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Util\**\*.cs" Link="Codigo\Util\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
