<Window x:Class="ConUni_CliEsc_GR08.Views.CambiarClaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cambiar Contrasena Corporativa" Height="400" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F172A" Foreground="White">
    <Border Padding="26" Background="#151B28" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Margin="16">
        <StackPanel>
            <TextBlock Text="Cambiar Contrasena" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
            <TextBlock Text="Se actualizara inmediatamente en el servidor REST central." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,16"/>

            <TextBlock Text="Contrasena Actual:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
            <PasswordBox x:Name="txtActual" FontSize="14" Padding="6" Margin="0,0,0,12" Background="#0D121C" Foreground="White" BorderBrush="#334155"/>

            <TextBlock Text="Nueva Contrasena (min 4 car):" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
            <PasswordBox x:Name="txtNueva" FontSize="14" Padding="6" Margin="0,0,0,12" Background="#0D121C" Foreground="White" BorderBrush="#334155"/>

            <TextBlock Text="Confirmar Nueva Contrasena:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
            <PasswordBox x:Name="txtConfirmar" FontSize="14" Padding="6" Margin="0,0,0,16" Background="#0D121C" Foreground="White" BorderBrush="#334155"/>

            <TextBlock x:Name="lblMensaje" Text="" FontSize="12" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Cancelar" Height="36" Background="#334155" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnCancelar_Click"/>
                <Button Grid.Column="2" Content="Guardar Clave" Height="36" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnGuardar_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
