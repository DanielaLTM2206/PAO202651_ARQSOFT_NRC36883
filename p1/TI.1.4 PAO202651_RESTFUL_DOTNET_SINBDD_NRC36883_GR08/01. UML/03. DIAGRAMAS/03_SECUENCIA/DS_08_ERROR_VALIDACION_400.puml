@startuml
title "DS_08_ERROR_VALIDACION_400"
autonumber

actor "APLICACION" as Aplicacion
participant "CONVERSION_VISTA" as ConversionVista
participant "CONVERSION_CONTROLADOR" as ConversionControlador
participant "CLIENTE_REST_CONVERSOR" as ClienteRest
participant "MANEJADOR_AUTENTICACION" as ManejadorAutenticacion
participant "API_REST_CONVERSOR" as API_REST_CONVERSOR
participant "UNIDAD_MAPPER" as UnidadMapper

Aplicacion -> ConversionVista: Ingresa unidad no soportada
ConversionVista -> ConversionControlador: solicitarConversionMasa(valor, unidadOrigenInvalida, unidadDestino)
ConversionControlador -> ClienteRest: convertirMasa(token, valor, unidadOrigenInvalida, unidadDestino)

ClienteRest -> ManejadorAutenticacion: POST /api/conversion/masa(...)\nHeader 'Authorization: Bearer <token>'
ManejadorAutenticacion --> API_REST_CONVERSOR: solicitud autorizada

API_REST_CONVERSOR -> UnidadMapper: toMasa(unidadOrigenInvalida)
UnidadMapper --> API_REST_CONVERSOR: RuntimeException("Unidad de masa invalida: ...")
API_REST_CONVERSOR --> ClienteRest: Fault de validacion (equivalente logico a 400)

ClienteRest --> ConversionControlador: error de validacion
ConversionControlador --> ConversionVista: mostrar mensaje de validacion
ConversionVista --> Aplicacion: solicitar correccion de datos

@enduml
