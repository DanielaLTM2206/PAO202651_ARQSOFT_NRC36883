<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:UniversalConverter.Client.ViewModels"
             xmlns:models="clr-namespace:UniversalConverter.Client.Models"
             xmlns:converters="clr-namespace:UniversalConverter.Client.Converters"
             x:DataType="viewModels:MainViewModel"
             x:Class="UniversalConverter.Client.MainPage"
             BackgroundColor="#0F172A">

    <ContentPage.Resources>
        <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
    </ContentPage.Resources>

    <Grid>
        <!-- Contenido Principal con Scroll -->
        <ScrollView>
            <VerticalStackLayout Padding="16,20" Spacing="16">

                <!-- Encabezado Corporativo -->
                <Border StrokeShape="RoundRectangle 16"
                        Stroke="#334155"
                        BackgroundColor="#151B28"
                        Padding="16,14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 8"
                                Stroke="#3B82F6"
                                StrokeThickness="2"
                                WidthRequest="44"
                                HeightRequest="44">
                            <Image Source="sullivan.png" Aspect="AspectFill"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="Conversor RESTful"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="White"/>
                                <Border BackgroundColor="#2563EB" StrokeShape="RoundRectangle 8" Padding="6,2">
                                    <Label Text="GR08" FontSize="9" FontAttributes="Bold" TextColor="White"/>
                                </Border>
                            </HorizontalStackLayout>
                            <Label Text="ASP.NET Core Web API .NET 8 (SINBDD)"
                                   FontSize="10"
                                   TextColor="#94A3B8"/>
                            <Label Text="{Binding UsuarioSesion, StringFormat='Sesion: {0}'}"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#38BDF8"/>
                        </VerticalStackLayout>

                        <!-- Botones de sesion -->
                        <VerticalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                            <Button Text="Clave"
                                    Command="{Binding AbrirModalClaveCommand}"
                                    BackgroundColor="#1E293B"
                                    TextColor="#E2E8F0"
                                    FontSize="10"
                                    HeightRequest="28"
                                    Padding="8,0"
                                    CornerRadius="6"/>
                            <Button Text="Salir"
                                    Command="{Binding LogoutCommand}"
                                    BackgroundColor="#B91C1C"
                                    TextColor="White"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    HeightRequest="28"
                                    Padding="8,0"
                                    CornerRadius="6"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Tarjeta Principal de Conversion -->
                <Border StrokeShape="RoundRectangle 16"
                        Stroke="#334155"
                        BackgroundColor="#151B28"
                        Padding="18,18">
                    <VerticalStackLayout Spacing="14">

                        <!-- Categoria de Conversion -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Categoria del Servicio:"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#CBD5E1"/>
                            <Border StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#0D121C" Padding="10,0">
                                <Picker ItemsSource="{Binding ConversionTypes}"
                                        SelectedItem="{Binding SelectedConversionType}"
                                        TextColor="White"
                                        TitleColor="#64748B"
                                        FontSize="13"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Valor Numerico a Convertir -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Valor a Convertir:"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#CBD5E1"/>
                            <Border StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#0D121C" Padding="10,2">
                                <Entry Text="{Binding ValorEntrada}"
                                       Keyboard="Numeric"
                                       TextColor="White"
                                       Placeholder="Ej: 100"
                                       PlaceholderColor="#64748B"
                                       FontSize="14"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Unidades Origen y Destino -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <!-- Origen -->
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="De (Origen):"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#CBD5E1"/>
                                <Border StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#0D121C" Padding="8,0">
                                    <Picker ItemsSource="{Binding UnitsFrom}"
                                            SelectedItem="{Binding SelectedUnitFrom}"
                                            TextColor="White"
                                            TitleColor="#64748B"
                                            FontSize="12"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Destino -->
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="A (Destino):"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#CBD5E1"/>
                                <Border StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#0D121C" Padding="8,0">
                                    <Picker ItemsSource="{Binding UnitsTo}"
                                            SelectedItem="{Binding SelectedUnitTo}"
                                            TextColor="White"
                                            TitleColor="#64748B"
                                            FontSize="12"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Boton Convertir -->
                        <Button Text="CONVERTIR UNIDAD"
                                Command="{Binding ConvertCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="46"
                                FontSize="13"
                                Margin="0,4,0,0"/>

                        <!-- Indicador de Carga -->
                        <ActivityIndicator IsRunning="{Binding IsBusy}" 
                                           Color="#38BDF8"
                                           HorizontalOptions="Center"/>

                        <!-- Tarjeta de Resultado Exitoso -->
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="#059669"
                                BackgroundColor="#064E3B"
                                Padding="14,14"
                                IsVisible="{Binding TieneResultado}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding ResultadoTitulo}"
                                       FontSize="11"
                                       TextColor="#A7F3D0"/>
                                <Label Text="{Binding ResultadoGrande}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="White"/>
                                <Label Text="{Binding ResultadoExacto}"
                                       FontSize="11"
                                       TextColor="#D1FAE5"/>
                                <Label Text="{Binding ResultadoFactor}"
                                       FontSize="10"
                                       TextColor="#6EE7B7"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Tarjeta de Error Controlado -->
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="#DC2626"
                                BackgroundColor="#2D1515"
                                Padding="14,14"
                                IsVisible="{Binding TieneError}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding ErrorCodigo, StringFormat='Error en la Conversion [{0}]'}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#FCA5A5"/>
                                <Label Text="{Binding ErrorMensaje}"
                                       FontSize="11"
                                       TextColor="White"/>
                                <Label Text="{Binding ErrorDetalles}"
                                       FontSize="10"
                                       TextColor="#CBD5E1"/>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- Seccion de Historial Sincronizado en Memoria -->
                <Border StrokeShape="RoundRectangle 16"
                        Stroke="#334155"
                        BackgroundColor="#151B28"
                        Padding="18,16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Historial Sincronizado"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="White"/>
                                <Label Text="En memoria compartida RESTful"
                                       FontSize="10"
                                       TextColor="#94A3B8"/>
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                <Button Text="Actualizar"
                                        Command="{Binding CargarHistorialCommand}"
                                        BackgroundColor="#1E293B"
                                        TextColor="#E2E8F0"
                                        FontSize="10"
                                        HeightRequest="30"
                                        Padding="8,0"
                                        CornerRadius="6"/>
                                <Button Text="Limpiar"
                                        Command="{Binding LimpiarHistorialCommand}"
                                        BackgroundColor="#7F1D1D"
                                        TextColor="#FCA5A5"
                                        FontSize="10"
                                        HeightRequest="30"
                                        Padding="8,0"
                                        CornerRadius="6"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Lista de Registros de Historial -->
                        <CollectionView ItemsSource="{Binding Historial}" HeightRequest="200">
                            <CollectionView.EmptyView>
                                <Label Text="No hay conversiones registradas en el servidor"
                                       TextColor="#64748B"
                                       FontSize="11"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,30,0,0"/>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:RegistroHistorial">
                                    <Border StrokeShape="RoundRectangle 8"
                                            Stroke="#1E293B"
                                            BackgroundColor="#0D121C"
                                            Padding="10,8"
                                            Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Border Grid.Column="0"
                                                    BackgroundColor="#1E293B"
                                                    StrokeShape="RoundRectangle 6"
                                                    Padding="6,2"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding TipoConversion}"
                                                       FontSize="9"
                                                       FontAttributes="Bold"
                                                       TextColor="#38BDF8"/>
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                <Label Text="{Binding ValorOriginal, StringFormat='{0}'}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="White"/>
                                                <Label Text="{Binding Fecha, StringFormat='{0:yyyy-MM-dd HH:mm:ss}'}"
                                                       FontSize="9"
                                                       TextColor="#64748B"/>
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center">
                                                <Label Text="{Binding ValorResultado, StringFormat='-> {0}'}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="#34D399"/>
                                                <Label Text="{Binding UnidadDestino}"
                                                       FontSize="9"
                                                       TextColor="#94A3B8"
                                                       HorizontalTextAlignment="End"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Modal Flotante de Cambio de Clave -->
        <Grid BackgroundColor="#CC000000"
              IsVisible="{Binding MostrarModalClave}"
              Padding="24">
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#334155"
                    BackgroundColor="#151B28"
                    Padding="22,22"
                    VerticalOptions="Center"
                    MaximumWidthRequest="360">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Cambiar Contrasena"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"/>
                    <Label Text="Actualiza tu clave en el servidor central"
                           FontSize="11"
                           TextColor="#94A3B8"/>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Clave Actual:" FontSize="11" TextColor="#CBD5E1"/>
                        <Border StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#0D121C" Padding="10,0">
                            <Entry Text="{Binding ClaveActual}" IsPassword="True" TextColor="White" FontSize="13"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nueva Clave (min 4 car):" FontSize="11" TextColor="#CBD5E1"/>
                        <Border StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#0D121C" Padding="10,0">
                            <Entry Text="{Binding ClaveNueva}" IsPassword="True" TextColor="White" FontSize="13"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Confirmar Nueva Clave:" FontSize="11" TextColor="#CBD5E1"/>
                        <Border StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#0D121C" Padding="10,0">
                            <Entry Text="{Binding ClaveConfirmar}" IsPassword="True" TextColor="White" FontSize="13"/>
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="{Binding MensajeClave}"
                           TextColor="#F87171"
                           FontSize="11"
                           IsVisible="{Binding MensajeClave, Converter={StaticResource IsNotNullConverter}}"
                           Margin="0,2,0,0"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                        <Button Grid.Column="0"
                                Text="Cancelar"
                                Command="{Binding CerrarModalClaveCommand}"
                                BackgroundColor="#334155"
                                TextColor="White"
                                HeightRequest="40"
                                CornerRadius="8"/>
                        <Button Grid.Column="1"
                                Text="Guardar"
                                Command="{Binding GuardarClaveCommand}"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                FontAttributes="Bold"
                                HeightRequest="40"
                                CornerRadius="8"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
